rules_version = '2';
service cloud.firestore {

  // --- CORE SYSTEM FUNCTIONS (v48.12.22) ---
  
  function isSignedIn() {
    return request.auth != null;
  }

  function hasRole(role) {
    let email = (request.auth.token != null && 'email' in request.auth.token) ? request.auth.token.email.lower() : '';
    let emailRole = (role == 'admin'       && (email.matches('.*pastor.*') || email.matches('.*admin.*') || email.matches('.*secretaria.*'))) ||
                    (role == 'reception'   && (email.matches('.*recepcao.*') || email.matches('.*checkin.*') || email.matches('.*eventos.*'))) ||
                    (role == 'kids'        && (email.matches('.*infantil.*') || email.matches('.*kids.*'))) ||
                    (role == 'integracao'  && (email.matches('.*missao.*') || email.matches('.*integracao.*'))) ||
                    (role == 'acolhimento' && (email.matches('.*acolhimento.*') || email.matches('.*missao.*'))) ||
                    (role == 'altar'       && (email.matches('.*altar.*') || email.matches('.*midia.*')));
    
    return isSignedIn() && (
      emailRole ||
      (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role)
    );
  }

  function isAdmin() {
    return hasRole('admin');
  }

  match /databases/{database}/documents {
    
    // --- NUCLEAR THAW: BULLE & DIACONIA DIRECT ACCESS ---
    // Liberação total para qualquer coleção que comece com 'bulle_' ou 'diaconia_' (exceto credenciais da diaconia)
    match /{collection}/{document} {
      allow read, write: if (collection.split('_')[0] == 'bulle' || collection.split('_')[0] == 'diaconia')
                          && collection != 'diaconia_escala_credenciais';
    }

    // --- PROTECTED CREDENTIALS (DIACONIA) ---
    // Impede a listagem de credenciais sensíveis (passwordHash e passwordSalt)
    // Permite leitura por ID e escrita apenas se a requisição estiver autenticada (no auth != null)
    match /diaconia_escala_credenciais/{membroId} {
      allow get: if request.auth != null;
      allow write: if request.auth != null;
      allow list: if false;
    }

    // --- DIAGNOSTIC COLLECTIONS (ROOT) ---
    match /volunteers/{docId}   { allow read, write: if true; }
    match /pending/{docId}      { allow read, write: if true; }
    match /users/{docId}        { allow read, write: if true; }
    match /attendance/{docId}   { allow read, write: if true; }
    match /leaders/{docId}      { allow read, write: if true; }
    match /birthdays/{docId}    { allow read, write: if true; }

    // --- DEDICATED CLEAN COLLECTIONS (NEW CES DIACONIA PROJECTS) ---
    // Regras de controle de acesso baseadas no perfil/role extraído do Token Customizado
    match /membros/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /credenciais/{docId} {
      allow get: if request.auth != null;
      allow write: if request.auth != null;
      allow list: if false;
    }
    match /setores/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /cultos/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /escalas/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /produtos/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /historico_estoque/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /reposicoes/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /avisos/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /disponibilidades/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /mensagens_supervisao/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /configuracoes/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /historico_substituicoes/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /escalas_arquivadas/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // --- CHECK-IN & EVENTS COLLECTIONS (LAUSANNE) ---
    match /events/{docId} {
      allow read: if isSignedIn();
    }
    match /event_attendance/{docId} {
      allow read: if isSignedIn();
      allow create: if hasRole('admin') || hasRole('reception');
      allow update: if hasRole('admin') || hasRole('reception');
    }
    match /event_registrations/{docId} {
      allow read: if isSignedIn();
      allow create, update: if hasRole('admin') || hasRole('reception');
    }

    // --- STANDARD COLLECTIONS (LAUSANNE) ---
    match /people/{docId} {
      allow read: if hasRole('admin') || hasRole('reception') || hasRole('integracao') || hasRole('followup') || hasRole('altar') || hasRole('acolhimento');
      allow write: if hasRole('admin') || hasRole('reception') || hasRole('integracao') || hasRole('followup') || hasRole('acolhimento');
    }
    match /kids/{docId} {
      allow read: if hasRole('kids') || hasRole('reception') || isAdmin();
      allow write: if hasRole('kids') || hasRole('reception') || isAdmin();
    }
    match /integracao/{docId} {
      allow create: if true;
      allow read, update, delete: if hasRole('admin') || hasRole('reception') || hasRole('integracao') || hasRole('acolhimento');
    }
    match /schedule_requests/{docId} {
      allow create: if true;
      allow read, update, delete: if hasRole('admin') || hasRole('reception') || hasRole('integracao') || hasRole('acolhimento');
    }
    match /decisions/{docId} {
      allow read, write: if hasRole('admin') || hasRole('reception') || hasRole('acolhimento') || hasRole('integracao');
    }

    // FALLBACK
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasRole('reception');
    }
  }
}
